<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{ block "title" . }}Dataset Hub{{ end }}</title>
  <link rel="stylesheet" href="/static/css/main.css">
</head>
<body>
<header>
  <h1>Dataset Hub</h1>
  <nav>
    <a href="/categories">Категории</a> |
    <a href="/datasets">Публичные датасеты</a> |
    {{ if or (eq .Role "user") (eq .Role "admin") }}
      <a href="/my-datasets">Мои датасеты</a> |
      <a href="/profile">Личный кабинет</a> |
    {{ end }}
    <a href="/notifications">Уведомления</a> |
    <a href="/reviews">Отзывы</a> |
    <a href="/subscriptions">Подписки</a> |
    {{ if eq .Role "guest" }}
      <a href="/login">Вход</a>
    {{ else }}
      <form action="/logout" method="post" style="display:inline;">
        <button type="submit">Выйти</button>
      </form>
    {{ end }}
  </nav>
  <hr>
</header>

<main>
  {{ block "content" . }}{{ end }}
</main>

<footer>
  <hr>
  <small>&copy; 2025 Dataset Hub</small>
</footer>
</body>
</html>
