<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{ block "title" . }}Dataset Hub{{ end }}</title>
  <link rel="stylesheet" href="/legacy/static/css/main.css">
</head>
<body>
<header>
  <h1>Dataset Hub</h1>
  <nav>
    <a href="/legacy/categories">Категории</a> |
    <a href="/legacy/datasets">Датасеты</a> |
    {{ if or (eq .Role "user") (eq .Role "admin") }}
      <a href="/legacy/my-datasets">Мои датасеты</a> |
      <a href="/legacy/profile">Личный кабинет</a> |
    {{ end }}
    {{ if or (eq .Role "user") (eq .Role "admin") }}
      <a href="/legacy/notifications">Уведомления</a> |
    {{ end }}
    {{ if eq .Role "guest" }}
      <a href="/legacy/login">Вход</a>
    {{ else }}
      <form action="/legacy/logout" method="post" style="display:inline;">
        <button type="submit">Выйти</button>
      </form>
    {{ end }}
  </nav>
  <hr>
</header>

<main>
  {{ block "content" . }}{{ end }}
</main>

<footer>
  <hr>
  <small>&copy; 2025 Dataset Hub</small>
</footer>
</body>
</html>
