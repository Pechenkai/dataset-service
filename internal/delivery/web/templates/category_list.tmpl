{{ define "title" }}Список категорий{{ end }}
 {{ define "content" }}
 <h2>Список категорий</h2>

 <table class="striped">
     <thead>
     <tr>
         <th>Название</th>
         <th>Описание</th>
         {{ if eq .Role "admin" }}
         <th>Действия</th>
         {{ end }}
     </tr>
     </thead>
     <tbody>
     {{ range .Categories }}
     <tr>
         <td><a href="{{$.BasePath}}/categories/{{ .ID }}">{{ .Name }}</a></td>
         <td>{{ .Description }}</td>
         {{ if eq $.Role "admin" }}
         <td>
             <a href="{{$.BasePath}}/categories/{{ .ID }}/edit">Редактировать</a> |
             <form style="display:inline;" method="POST" action="{{$.BasePath}}/categories/{{ .ID }}/delete">
                 <button type="submit" onclick="return confirm('Удалить категорию?');">Удалить</button>
             </form>
         </td>
        {{ end }}
     </tr>
     {{ end }}
     </tbody>
 </table>
 {{ end }}