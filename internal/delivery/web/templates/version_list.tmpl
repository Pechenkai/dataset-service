{{ define "title" }}Версии датасета #{{ .DatasetID }}{{ end }}
{{ define "content" }}
<h2>{{ .Title }}</h2>
<table class="striped">
    <thead>
    <tr><th>Номер</th><th>Изменения</th><th>Дата</th><th>Скачать</th></tr>
    </thead>
    <tbody>
    {{ range .Versions }}
    <tr>
        <td>{{ .Number }}</td>
        <td>{{ .ChangeLog }}</td>
        <td>{{ .CreatedAt.Format "2006-01-02 15:04" }}</td>
        <td><a href="{{ .DownloadURL }}">Скачать</a></td>
    </tr>
    {{ end }}
    </tbody>
</table>
<p><a href="/legacy/datasets/{{ .DatasetID }}">Назад к датасету</a></p>
{{ end }}