{{ define "title" }}Запросы доступа{{ end }}

{{ define "content" }}
<h2>Запросы доступа</h2>

{{ if not .Requests }}
<p>Нет новых запросов доступа.</p>
{{ else }}
<table class="striped">
    <thead>
    <tr>
        <th>Пользователь</th>
        <th>Датасет</th>
        <th>Дата запроса</th>
        <th>Действие</th>
    </tr>
    </thead>
    <tbody>
    {{ range .Requests }}
    <tr>
        <td>{{ .Username }}</td>
        <td><a href="{{$.BasePath}}/datasets/{{ .DatasetID }}">{{ .DatasetName }}</a></td>
        <td>{{ .CreatedAt.Format "2006-01-02 15:04" }}</td>
        <td>
            <form action="{{$.BasePath}}/access-requests/{{ .ID }}/approve" method="post" style="display:inline;">
                <button type="submit">Принять</button>
            </form>
            <form action="{{$.BasePath}}/access-requests/{{ .ID }}/deny" method="post" style="display:inline;">
                <button type="submit">Отклонить</button>
            </form>
        </td>
    </tr>
    {{ end }}
    </tbody>
</table>
{{ end }}
{{ end }}