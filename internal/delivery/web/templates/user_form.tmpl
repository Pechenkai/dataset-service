 {{ define "content" }}
 <h2>{{ if .IsNew }}Регистрация нового пользователя{{ else }}Редактирование пользователя #{{ .Form.ID }}{{ end }}</h2>

 <form method="POST" action="{{ .FormAction }}">
   {{ if not .IsNew }}
     <input type="hidden" name="id" value="{{ .Form.ID }}">
   {{ end }}

   <div>
     <label for="username">Username:</label><br>
     <input type="text" id="username" name="username" required value="{{ .Form.Username }}">
   </div>

   <div>
     <label for="email">Email:</label><br>
     <input type="email" id="email" name="email" required value="{{ .Form.Email }}">
   </div>

   <div>
     <label for="password">{{ if .IsNew }}Пароль{{ else }}Новый пароль (оставьте пустым, чтобы не менять){{ end }}:</label><br>
     <input type="password" id="password" name="password" {{ if .IsNew }}required{{ end }}>
   </div>

   <div>
     <label for="country">Страна:</label><br>
     <input type="text" id="country" name="country" required value="{{ .Form.Country }}">
   </div>

   <button type="submit">{{ if .IsNew }}Зарегистрировать{{ else }}Обновить{{ end }}</button>
   <a href="{{ if .IsNew }}/login{{ else }}/users/{{ .Form.ID }}{{ end }}">Отмена</a>
 </form>
 {{ end }}