{{ define "title" }}Список датасетов{{ end }}

{{ define "content" }}
<h2>Датасеты</h2>

<table class="striped">
  <thead>
  <tr>
    <th>Название</th>
    <th>Описание</th>
    <th>Владелец</th>
    <th>Действия</th>
  </tr>
  </thead>
  <tbody>
  {{ range .Datasets }}
  <tr>
    <td><a href="/datasets/{{ .ID }}">{{ .Name }}</a></td>
    <td>{{ .Description }}</td>
    <td>{{ .OwnerName }}</td>
    <td>
      {{ if .IsPublic }}
      {{ if not .IsSubscribed }}
      <form action="/subscriptions" method="post" style="display:inline;">
        <input type="hidden" name="dataset_id" value="{{ .ID }}">
        <button type="submit">Подписаться</button>
      </form>
      {{ else }}
      <form action="/subscriptions/{{ .ID }}/unsubscribe" method="post" style="display:inline;">
        <button type="submit">Отписаться</button>
      </form>
      {{ end }}
      |
      <a href="/datasets/{{ .ID }}/download">Скачать</a>
      {{ else }}
      —
      {{ end }}
    </td>
  </tr>
  {{ end }}
  </tbody>
</table>

{{ if or (eq .Role "user") (eq .Role "admin") }}
<p><a href="/my-datasets">Мои датасеты</a></p>
{{ end }}
{{ end }}
