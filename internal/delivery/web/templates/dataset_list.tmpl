{{ define "title" }}Список датасетов{{ end }}

{{ define "content" }}
<h2>Датасеты</h2>

<table class="striped">
  <thead>
    <tr>
      <th>Название</th>
      <th>Описание</th>
      <th>Владелец</th>
      <th>Действия</th>
    </tr>
  </thead>
  <tbody>
    {{ range .Datasets }}
      <tr>
        <td><a href="/datasets/{{ .ID }}">{{ .Name }}</a></td>
        <td>{{ .Description }}</td>
        <td>{{ .OwnerName }}</td>
        <td>
          —
        </td>
      </tr>
    {{ end }}
  </tbody>
</table>

{{/* Если ты зарегистрирован(а), показать ссылку на «Мои датасеты» */}}
{{ if or (eq .Role "user") (eq .Role "admin") }}
  <p><a href="/my-datasets">Мои датасеты</a></p>
{{ end }}
{{ end }}