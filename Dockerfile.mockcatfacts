# syntax=docker/dockerfile:1

FROM golang:1.22-alpine AS builder
ENV GOTOOLCHAIN=auto
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /app/mockcatfacts ./cmd/mockcatfacts

FROM alpine:3.19
WORKDIR /srv
COPY --from=builder /app/mockcatfacts /usr/local/bin/mockcatfacts
EXPOSE 9099
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD wget -qO- http://127.0.0.1:9099/fact || exit 1
ENTRYPOINT ["/usr/local/bin/mockcatfacts"]
