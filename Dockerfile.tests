FROM golang:1.24

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN chmod +x scripts/run-tests.sh

ENV GOCACHE=/tmp/.gocache

ENTRYPOINT ["/app/scripts/run-tests.sh"]
CMD ["unit"]
