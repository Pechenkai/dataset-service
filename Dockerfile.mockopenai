# syntax=docker/dockerfile:1

FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/mockopenai cmd/mockopenai
COPY internal/integrations/openai internal/integrations/openai
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /app/mockopenai ./cmd/mockopenai

FROM alpine:3.19
WORKDIR /srv
COPY --from=builder /app/mockopenai /usr/local/bin/mockopenai
EXPOSE 8088
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD wget -qO- http://127.0.0.1:8088/chat/completions || exit 1
ENTRYPOINT ["/usr/local/bin/mockopenai"]
